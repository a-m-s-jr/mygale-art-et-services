/** @type {import('next').NextConfig} */
import path from 'path'
import { fileURLToPath } from 'url'

const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)

// This points turbopack to the app root (apps/web) — ensures turbopack finds next/package.json
const turbopackRoot = path.resolve(__dirname)

// If you have a monorepo and want tracing to include packages at monorepo root,
// set outputFileTracingRoot to the monorepo root (adjust if different).
// E.g. path.resolve(__dirname, '..', '..') if apps/web is nested under repo root.
const outputFileTracingRoot = path.resolve(__dirname, '..', '..')
const nextConfig = {
  images: {
    unoptimized: false,
    remotePatterns: [],
  },
  experimental: {
    serverActions: {
      allowedOrigins: ['*'],
    },
  },
  compress: true,
  poweredByHeader: false,
  // Force turbopack root (fixes "couldn't find next/package.json" errors)
  turbopack: {
    root: turbopackRoot,
  },

  // Make output-file tracing root explicit (helps with monorepos)
  outputFileTracingRoot,

  // Optional: if Vercel is still selecting Turbopack and you want to build with webpack:
  // (Either set this locally for debugging, or set NEXT_DISABLE_TURBOPACK=1 env var in Vercel)
  // experimental: { turbo: {...} }
  eslint: {
    // avoid ESlint failures stopping production builds
    ignoreDuringBuilds: true,
  },
}

module.exports = nextConfig
