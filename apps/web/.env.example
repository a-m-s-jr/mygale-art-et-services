# CDN and CloudFront signing settings
CDN_URL=https://media.mygaleartetservices.org
CLOUDFRONT_KEY_PAIR_ID=YOUR_KEY_PAIR_ID
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
CLOUDFRONT_COOKIE_DOMAIN=.mygaleartetservices.org
CLOUDFRONT_COOKIE_TTL_SECONDS=3600

# Frontend origin for CORS
FRONTEND_URL=https://www.mygaleartetservices.org

# AWS S3 settings for uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_S3_BUCKET=your-private-bucket-name
