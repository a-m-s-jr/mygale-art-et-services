{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2019",
    "composite": true,
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "src",
    "declaration": true,
    "removeComments": true,
    "noEmit": false,
    "incremental": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "jest.config.js", "src/**/*", "src/types/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
