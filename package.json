{
  "name": "mygale-art-et-services",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "",
  "main": "index.js",
  "exports": {
    ".": "./src/client/index.js",
    "./utils/auditLogger": "./src/utils/auditLogger.ts"
  },
  "scripts": {
    "dev:web": "cd apps/web && pnpm dev --webpack",
    "dev:api": "cd apps/api && pnpm start:dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "pnpm db:up && concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "db:generate": "pnpm --filter @mygale/prisma db:generate",
    "db:push": "pnpm --filter @mygale/prisma db:push",
    "db:studio": "pnpm --filter @mygale/prisma db:studio",
    "db:migrate": "pnpm --filter @mygale/prisma db:migrate",
    "db:migrate:dev": "pnpm --filter @mygale/prisma exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @mygale/prisma exec prisma migrate deploy",
    "build:web": "cd apps/web && pnpm build",
    "build:api": "cd apps/api && pnpm build",
    "build": "pnpm -w turbo run build",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write .",
    "prisma:generate": "pnpm -w prisma generate",
    "prepare": "husky",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter api test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.0.0",
    "prisma": "^6.19.0",
    "turbo": "^2.6.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "concurrently": "^8.2.2",
    "glob": "^11.0.3",
    "rimraf": "^6.1.0"
  }
}
