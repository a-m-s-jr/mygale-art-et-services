{
  "name": "mygale-art-et-services",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && bun run start:dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "dev": "node scripts/dev-with-cleanup.js",
    "db:generate": "bunx prisma generate --schema packages/prisma/prisma/schema.prisma",
    "db:push": "bunx prisma db push --schema packages/prisma/prisma/schema.prisma",
    "db:studio": "bunx prisma studio --schema packages/prisma/prisma/schema.prisma",
    "db:migrate": "bunx prisma migrate dev --schema packages/prisma/prisma/schema.prisma",
    "db:migrate:deploy": "bunx prisma migrate deploy --schema packages/prisma/prisma/schema.prisma",
    "db:reset": "bun run db:down && bun run db:up && bunx prisma migrate deploy --schema packages/prisma/prisma/schema.prisma && bunx prisma generate --schema packages/prisma/prisma/schema.prisma",
    "build:web": "cd apps/web && bun run build",
    "build:api": "cd apps/api && bun run build",
    "build": "bunx turbo run build",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "bunx turbo run test --parallel",
    "test:api": "cd apps/api && bun run test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.3.0",
    "framer-motion": "^12.23.24",
    "glob": "^11.0.3",
    "nodemailer": "^7.0.10",
    "rimraf": "^6.1.0",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/nodemailer": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "8.2.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.0.0",
    "prisma": "^6.19.0",
    "turbo": "^2.6.1"
  }
}
