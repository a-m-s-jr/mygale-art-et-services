generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use pooled connection for runtime queries (can be Supabase Pooler / PgBouncer)
  url       = env("DATABASE_URL")
  // Use direct connection for migrations/introspection (must NOT be PgBouncer)
  directUrl = env("DIRECT_URL")
}

/* ----------------------------
   USER & AUTH MODELS
----------------------------- */

model User {
  id                  String              @id @default(cuid())
  name                String
  passwordHash        String
  email               String              @unique
  role                Role?
  phone               String?
  createdAt           DateTime            @default(now())

  auditLogs           AuditLog[]
  assignedSubmissions ContactSubmission[]

  accounts Account[]
  sessions Session[]
}

enum Role {
  ADMIN
  STAFF
  VIEWER
  USER
}

/* ----------------------------
   CONTACT SUBMISSIONS
----------------------------- */

model ContactSubmission {
  id           String           @id @default(cuid())
  name         String
  email        String
  phone        String?
  message      String
  source       String?
  createdAt    DateTime         @default(now())

  status       SubmissionStatus @default(new)

  assignedToId String?
  assignedTo   User?            @relation(fields: [assignedToId], references: [id])

  auditLogs    AuditLog[]
  replies      Reply[]
}

enum SubmissionStatus {
  new
  in_review
  responded
  closed
}

/* ----------------------------
   AUDIT LOGS
----------------------------- */

model AuditLog {
  id                  String            @id @default(cuid())
  contactSubmissionId String?
  contactSubmission   ContactSubmission? @relation(fields: [contactSubmissionId], references: [id])

  actorId             String?
  actor               User?             @relation(fields: [actorId], references: [id])

  action              String
  createdAt           DateTime          @default(now())

  meta                Json?
}

/* ----------------------------
   REPLIES
----------------------------- */

model Reply {
  id                  String            @id @default(cuid())
  submissionId        String
  submission          ContactSubmission @relation(fields: [submissionId], references: [id])

  body                String
  channel             ReplyChannel
  sentAt              DateTime          @default(now())

  meta                Json?
}

enum ReplyChannel {
  email
  phone
  whatsapp
  note
}

/* ----------------------------
   NEXTAUTH MODELS
----------------------------- */

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model WebhookAttempt {
  id          String   @id @default(cuid())
  webhookUrl  String
  payload     Json
  status      String   @default("pending") // pending / success / failed
  response    String?  // response text or error (short)
  attempt     Int      @default(0)
  maxAttempts Int      @default(5)
  nextRetryAt DateTime? 
  createdAt   DateTime @default(now())

  @@index([webhookUrl])
  @@index([status])
}

/* ----------------------------
   PRODUCTS & SERVICES
----------------------------- */

model Product {
  id          String      @id @default(cuid())
  name        String
  title       String
  description String?
  price       Float
  images      String[]    @default([])
  type        ProductType @default(PRODUCT)
  published   Boolean     @default(false)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum ProductType {
  PRODUCT
  SERVICE
}

/* ----------------------------
   ANNOUNCEMENTS
----------------------------- */

model Announcement {
  id          String            @id @default(cuid())
  title       String
  message     String
  imageUrl    String?
  type        AnnouncementType  @default(info)
  active      Boolean           @default(true)
  dismissible Boolean           @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum AnnouncementType {
  info
  warning
  promo
  success
  error
}

/* ----------------------------
   BLOG POSTS
----------------------------- */

model BlogPost {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  content        String
  excerpt        String?
  coverImage     String?
  seoTitle       String?
  seoDescription String?
  published      Boolean     @default(false)
  featured       Boolean     @default(false)
  publishedAt    DateTime?
  locale         BlogLocale  @default(fr)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum BlogLocale {
  fr
  en
}